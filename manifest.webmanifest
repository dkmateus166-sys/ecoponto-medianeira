{
  "name": "EcoMedianeira — Reciclagem de eletrônicos",
  "short_name": "EcoMedianeira",
  "description": "Agende a coleta de eletrônicos em Medianeira/PR, encontre pontos de coleta e acompanhe o impacto ambiental.",
  "id": "/ecoponto-medianeira/",
  "start_url": "./#/inicio",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0b1512",
  "theme_color": "#0f766e",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": [
    "utilities",
    "productivity",
    "education"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "play-shot-telefone.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tela inicial do EcoMedianeira"
    },
    {
      "src": "play-shot-tablet.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Mapa de pontos de coleta"
    }
  ],
  "shortcuts": [
    {
      "name": "Solicitar coleta",
      "short_name": "Coleta",
      "url": "./#/solicitar",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Pontos de coleta",
      "short_name": "Pontos",
      "url": "./#/pontos",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Acompanhar solicitações",
      "short_name": "Acompanhar",
      "url": "./#/acompanhar",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
